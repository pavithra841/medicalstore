pipeline {
    agent any

    environment {
        DOCKERHUB_USER = '23mis0160'
        IMAGE_NAME = "${DOCKERHUB_USER}/medistore"
        IMAGE_TAG = 'v3'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out v3 branch...'
                checkout scm
            }
        }

        stage('Validate') {
            steps {
                echo 'Validating HTML and Dockerfile...'
                bat 'if exist v3\\index.html (echo index.html OK) else (exit 1)'
                bat 'if exist v3\\Dockerfile (echo Dockerfile OK) else (exit 1)'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
                bat "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ./v3"
            }
        }

        stage('Test Container') {
            steps {
                echo 'Running container smoke test...'
                bat "docker run -d --name test-medistore-v3 -p 8083:80 ${IMAGE_NAME}:${IMAGE_TAG}"
                bat 'ping -n 6 127.0.0.1 > nul'
                bat 'curl -f http://localhost:8083 || exit 1'
                bat 'docker rm -f test-medistore-v3'
                echo 'Smoke test passed!'
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    bat "docker login -u %DOCKER_USER% -p %DOCKER_PASS%"
                    bat "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo 'Deploying v3 to Kubernetes...'
                bat 'kubectl apply -f kubernetes/medistore-v3.yaml'
                bat 'kubectl rollout status deployment/medistore-v3 --timeout=60s'
            }
        }
    }

    post {
        success {
            echo '✅ MediStore v3 deployed! Access at http://localhost:30083'
        }
        failure {
            echo '❌ Pipeline failed. Check the logs above.'
            bat 'docker rm -f test-medistore-v3 || exit 0'
        }
    }
}
