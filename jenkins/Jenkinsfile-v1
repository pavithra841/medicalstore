pipeline {
    agent any

    environment {
        DOCKERHUB_USER = '23mis0160'
        IMAGE_NAME = "${DOCKERHUB_USER}/medistore"
        IMAGE_TAG = 'v1'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out v1 branch...'
                checkout scm
            }
        }

        stage('Validate') {
            steps {
                echo 'Validating HTML and Dockerfile...'
                bat 'if exist v1\\index.html (echo index.html OK) else (exit 1)'
                bat 'if exist v1\\Dockerfile (echo Dockerfile OK) else (exit 1)'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
                bat "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ./v1"
            }
        }

        stage('Test Container') {
            steps {
                echo 'Running container smoke test...'
                bat "docker run -d --name test-medistore-v1 -p 8081:80 ${IMAGE_NAME}:${IMAGE_TAG}"
                bat 'ping -n 6 127.0.0.1 > nul'
                bat 'curl -f http://localhost:8081 || exit 1'
                bat 'docker rm -f test-medistore-v1'
                echo 'Smoke test passed!'
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    bat "docker login -u %DOCKER_USER% -p %DOCKER_PASS%"
                    bat "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo 'Deploying v1 to Kubernetes...'
                bat 'kubectl apply --kubeconfig "C:\ProgramData\Jenkins\.jenkins\.kube\config" -f kubernetes/medistore-v1.yaml --validate=false'
                bat 'kubectl rollout status deployment/medistore-v1 --timeout=60s'
            }
        }
    }

    post {
        success {
            echo '✅ MediStore v1 deployed! Access at http://localhost:30081'
        }
        failure {
            echo '❌ Pipeline failed. Check the logs above.'
            bat 'docker rm -f test-medistore-v1 || exit 0'
        }
    }
}
